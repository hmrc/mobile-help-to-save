# Add all the application routes to the app.routes file
GET           /clear-goal-events               uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.clearGoalEvents()
GET           /goal-events/:nino               uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.getGoalEvents(nino: uk.gov.hmrc.domain.Nino)
GET           /clear-milestone-data            uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.clearMilestoneData()
PUT           /create-goal                     uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.putSavingsGoal()
PUT           /add-milestone                   uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.addMilestone()
PUT           /add-milestones/:amount          uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.addMilestones(amount: Int)
GET           /eligibility/:nino               uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.getEligibility(nino: uk.gov.hmrc.domain.Nino)
PUT           /eligibility                     uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.setEligibility()
DELETE        /eligibility/:nino               uk.gov.hmrc.mobilehelptosave.controllers.test.TestController.deleteEligibility(nino: uk.gov.hmrc.domain.Nino)
